+        counts=np.array([np.histogram(cu[(cy>lo)&(cy<hi)],bins)[0] for lo,hi in [(.35,.85),(.85,1.35),(1.35,1.85)]])
+        through=gaussian_filter1d(counts.astype(float),1,axis=1)
