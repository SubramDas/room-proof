{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property_plan.schema.json",
  "title": "RoomProof property plan output",
  "description": "Project-owned output contract, version 0.1.0. This is not an evaluator-supplied schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "property_id", "run_id", "capture", "coordinate_system", "plan", "rooms", "adjacency", "damage_regions", "concealed_damage_flags", "scope_items", "warnings"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "property_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "capture": {"$ref": "#/$defs/capture"},
    "coordinate_system": {"$ref": "#/$defs/coordinate_system"},
    "plan": {"$ref": "#/$defs/plan"},
    "rooms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/room"}},
    "adjacency": {"type": "array", "items": {"$ref": "#/$defs/adjacency"}},
    "damage_regions": {"type": "array", "items": {"$ref": "#/$defs/damage_region"}},
    "concealed_damage_flags": {"type": "array", "items": {"$ref": "#/$defs/concealed_flag"}},
    "scope_items": {"type": "array", "items": {"$ref": "#/$defs/scope_item"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "tier": {"enum": ["photo", "video", "lidar"]},
    "observation_status": {"enum": ["observed", "inferred", "unresolved"]},
    "source_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "measurement": {
      "description": "A physical measurement, including an explicit interval. Null interval bounds mean that the side is unbounded; null value means no usable point estimate. Coordinates and probabilities are not physical measurements.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "interval", "status", "source_refs"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"enum": ["m", "m2"]},
        "interval": {"$ref": "#/$defs/interval"},
        "status": {"$ref": "#/$defs/observation_status"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "coverage", "method"],
      "properties": {
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "coverage": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "point2": {
      "description": "Plan coordinates in metres; these are drawing coordinates, not independently reported measurements.",
      "type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false
    },
    "polygon2": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point2"}},
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["capture_id", "tier", "device_model", "ios_version", "capture_app", "source_refs"],
      "properties": {
        "capture_id": {"$ref": "#/$defs/id"},
        "tier": {"$ref": "#/$defs/tier"},
        "device_model": {"type": ["string", "null"]},
        "ios_version": {"type": ["string", "null"]},
        "capture_app": {"type": ["string", "null"]},
        "capture_app_version": {"type": ["string", "null"]},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      }
    },
    "coordinate_system": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "origin", "x_axis", "y_axis"],
      "properties": {
        "unit": {"const": "m"},
        "origin": {"const": "capture_local"},
        "x_axis": {"const": "right_on_plan"},
        "y_axis": {"const": "up_on_plan"}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "footprint", "floor_area", "rendered_plan_path"],
      "properties": {
        "status": {"$ref": "#/$defs/observation_status"},
        "footprint": {"anyOf": [{"$ref": "#/$defs/polygon2"}, {"type": "null"}]},
        "floor_area": {"$ref": "#/$defs/measurement"},
        "rendered_plan_path": {"type": "string", "minLength": 1}
      }
    },
    "room": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "floor_id", "kind", "status", "boundary", "floor_area", "ceiling_height", "surfaces", "openings", "source_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "floor_id": {"type": ["string", "null"]},
        "kind": {"enum": ["room", "connector", "stairs", "other"]},
        "status": {"$ref": "#/$defs/observation_status"},
        "boundary": {"anyOf": [{"$ref": "#/$defs/polygon2"}, {"type": "null"}]},
        "floor_area": {"$ref": "#/$defs/measurement"},
        "ceiling_height": {"$ref": "#/$defs/measurement"},
        "surfaces": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/surface"}},
        "openings": {"type": "array", "items": {"$ref": "#/$defs/opening"}},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "allOf": [
        {"properties": {"surfaces": {"contains": {"properties": {"kind": {"const": "wall"}}}}}},
        {"properties": {"surfaces": {"contains": {"properties": {"kind": {"const": "floor"}}}}}},
        {"properties": {"surfaces": {"contains": {"properties": {"kind": {"const": "ceiling"}}}}}}
      ]
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "area", "source_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["wall", "floor", "ceiling"]},
        "status": {"$ref": "#/$defs/observation_status"},
        "line": {"type": "array", "prefixItems": [{"$ref": "#/$defs/point2"}, {"$ref": "#/$defs/point2"}], "items": false},
        "length": {"$ref": "#/$defs/measurement"},
        "area": {"$ref": "#/$defs/measurement"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "wall"}}}, "then": {"required": ["line", "length"]}}
      ]
    },
    "opening": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "surface_id", "status", "width", "height", "offset_along_wall", "source_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["door", "window", "other"]},
        "surface_id": {"$ref": "#/$defs/id"},
        "status": {"$ref": "#/$defs/observation_status"},
        "width": {"$ref": "#/$defs/measurement"},
        "height": {"$ref": "#/$defs/measurement"},
        "offset_along_wall": {"$ref": "#/$defs/measurement"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      }
    },
    "adjacency": {
      "type": "object", "additionalProperties": false,
      "required": ["room_a_id", "room_b_id", "opening_id", "status", "confidence", "source_refs"],
      "properties": {
        "room_a_id": {"$ref": "#/$defs/id"},
        "room_b_id": {"$ref": "#/$defs/id"},
        "opening_id": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/observation_status"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      }
    },
    "damage_region": {
      "description": "The polygon uses surface-local metres with origin at the surface's lower-left corner; class vocabulary remains to be agreed.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "room_id", "surface_id", "class", "status", "region", "width", "height", "area", "source_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "room_id": {"$ref": "#/$defs/id"},
        "surface_id": {"$ref": "#/$defs/id"},
        "class": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/observation_status"},
        "region": {"anyOf": [{"$ref": "#/$defs/polygon2"}, {"type": "null"}]},
        "length": {"$ref": "#/$defs/measurement"},
        "width": {"$ref": "#/$defs/measurement"},
        "height": {"$ref": "#/$defs/measurement"},
        "area": {"$ref": "#/$defs/measurement"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      }
    },
    "concealed_flag": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "room_id", "surface_id", "rule_id", "reason", "evidence_refs", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "room_id": {"$ref": "#/$defs/id"},
        "surface_id": {"$ref": "#/$defs/id"},
        "rule_id": {"$ref": "#/$defs/id"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/source_refs"},
        "status": {"$ref": "#/$defs/observation_status"}
      }
    },
    "scope_item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "room_id", "surface_id", "damage_region_id", "work_type", "description", "quantity", "source_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "room_id": {"$ref": "#/$defs/id"},
        "surface_id": {"$ref": "#/$defs/id"},
        "damage_region_id": {"type": ["string", "null"]},
        "work_type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "quantity": {"$ref": "#/$defs/measurement"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      }
    }
  }
}
